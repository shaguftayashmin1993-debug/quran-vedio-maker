{
  "entities": {
    "users": {
      "description": "User profile with role and subscription status",
      "fields": {
        "email": { "type": "string", "required": true },
        "displayName": { "type": "string", "required": false },
        "photoURL": { "type": "string", "required": false },
        "role": { "type": "string", "required": true, "enumValues": ["admin", "subscriber", "member", "guest"] },
        "status": { "type": "string", "required": true, "enumValues": ["active", "pending", "revoked"] },
        "subscriptionPlan": { "type": "string", "required": false },
        "createdAt": { "type": "string", "required": true },
        "lastLoginAt": { "type": "string", "required": false }
      }
    },
    "allowed_users": {
      "description": "Whitelist of authorized users and active subscribers allowed to access the studio",
      "fields": {
        "email": { "type": "string", "required": true },
        "role": { "type": "string", "required": true, "enumValues": ["admin", "subscriber", "member"] },
        "status": { "type": "string", "required": true, "enumValues": ["active", "revoked"] },
        "notes": { "type": "string", "required": false },
        "addedBy": { "type": "string", "required": true },
        "addedAt": { "type": "string", "required": true }
      }
    },
    "access_requests": {
      "description": "Incoming requests for access or subscription",
      "fields": {
        "email": { "type": "string", "required": true },
        "displayName": { "type": "string", "required": false },
        "reason": { "type": "string", "required": false },
        "plan": { "type": "string", "required": false },
        "status": { "type": "string", "required": true, "enumValues": ["pending", "approved", "rejected"] },
        "requestedAt": { "type": "string", "required": true }
      }
    },
    "access_codes": {
      "description": "Invitation passcodes generated by admin to grant instant access",
      "fields": {
        "code": { "type": "string", "required": true },
        "role": { "type": "string", "required": true },
        "usesLeft": { "type": "number", "required": true },
        "createdBy": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true }
      }
    },
    "users/{userId}/saved_videos": {
      "description": "User saved Quran videos in cloud",
      "fields": {
        "surahNumber": { "type": "number", "required": true },
        "surahName": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "reciterName": { "type": "string", "required": true },
        "startAyah": { "type": "number", "required": true },
        "endAyah": { "type": "number", "required": true },
        "duration": { "type": "number", "required": true },
        "aspectRatio": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true }
      }
    }
  }
}
